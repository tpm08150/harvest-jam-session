[Unit]
Description=Jam Session: page server
Documentation=https://github.com/tpm08150/harvest-jam-session/blob/main/pi/README.md

[Service]
# ⚠️ SERVED, NOT OPENED AS A FILE. Web MIDI needs a secure context; file:// is not one and
# http://localhost is. Bound to 127.0.0.1: the rack is for the browser on this box.
Type=simple
User=jam
WorkingDirectory=/opt/jam-session
Environment=PORT=8123
EnvironmentFile=-/etc/jam-session.conf
EnvironmentFile=-/boot/firmware/jam-session.txt
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/python3 /opt/jam-session/serve.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
