[Unit]
Description=Jam Session: the CPU at full speed
Documentation=https://github.com/tpm08150/harvest-jam-session/blob/main/pi/README.md

[Service]
# A groovebox has one job and a steady clock is it. The default governor drops the CPU's speed when it
# is idle and raises it again when work arrives — work that, for audio, is already late by then. With
# cooling on the Pi this costs a little heat and nothing else.
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do echo performance > "$g"; done'

[Install]
WantedBy=multi-user.target
