# PAM for jam-kiosk.service — the kiosk's login session. Nobody types a password: systemd opens the
# session itself, and pam_systemd is what makes it a real seat session in which cage may open the
# display and the GPU without being root.
auth      required  pam_unix.so nullok
account   required  pam_unix.so
session   required  pam_unix.so
session   required  pam_systemd.so
session   optional  pam_env.so
