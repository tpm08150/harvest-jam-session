#!/usr/bin/env python3
"""What a Jam Session Pi is doing: the board, heat, CPU, MIDI devices, PipeWire, and the rack itself.

It changes nothing. Run it on the Pi, or from a computer that can reach the Pi over SSH:

    ssh you@jam-session.local python3 - < pi/jam-diagnose > _pi-diag.txt

Questions that need the kiosk user's own session (PipeWire) are asked with `sudo -n -u jam`, and say
so when sudo will not answer without a password. The rack's answers come from Chromium's DevTools port
on 127.0.0.1 — the one pi/jam-browser opened — so they describe the page that is actually running.
"""
import json
import os
import re
import subprocess
import time
import urllib.request

DEVTOOLS = int(os.environ.get("DEVTOOLS_PORT") or 9222)


def section(title):
    print("\n==== " + title, flush=True)


def sh(cmd, timeout=25):
    try:
        r = subprocess.run(["/bin/bash", "-c", cmd], capture_output=True, text=True, timeout=timeout)
        out, err = r.stdout.rstrip(), r.stderr.rstrip()
        if out:
            print(out, flush=True)
        if err:
            print("[stderr] " + err, flush=True)
        if not out and not err:
            print("(nothing, exit %d)" % r.returncode, flush=True)
    except subprocess.TimeoutExpired:
        print("(gave up after %d s)" % timeout, flush=True)


def as_jam(cmd):
    uid = subprocess.run(["id", "-u", "jam"], capture_output=True, text=True).stdout.strip()
    if not uid:
        return "echo 'there is no jam user'"
    return ("sudo -n -u jam env XDG_RUNTIME_DIR=/run/user/%s DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%s/bus %s"
            % (uid, uid, cmd))


def processes():
    """Every process holding over 20 MB or averaging over 2% CPU since it started, largest first, with
    Chromium's helpers named by what they are — on a 1 GB Pi the question is who has the memory."""
    out = subprocess.run(["ps", "-eo", "pid=,rss=,pcpu=,args="], capture_output=True, text=True).stdout
    rows = []
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 4:
            continue
        pid, rss, cpu, args = parts
        mb, cpu = int(rss) // 1024, float(cpu)
        if mb < 20 and cpu < 2:
            continue
        name = os.path.basename(args.split()[0])
        kind = re.search(r"--type=([\w-]+)", args)
        sub = re.search(r"--utility-sub-type=([\w.]+)", args)
        if kind:
            name += " (%s)" % (sub.group(1) if sub else kind.group(1))
        elif "chrom" in name:
            name += " (browser)"
        rows.append((mb, cpu, pid, name))
    print("    MB  %CPU      PID  process", flush=True)
    for mb, cpu, pid, name in sorted(rows, reverse=True)[:16]:
        print("%6d %5.1f %8s  %s" % (mb, cpu, pid, name), flush=True)


class DevTools:
    def __init__(self, url):
        import websocket                           # python3-websocket, installed with the image
        self.ws = websocket.create_connection(url, timeout=20, suppress_origin=True)
        self.n = 0
        self.events = []

    def call(self, method, params=None, timeout=40):
        self.n += 1
        mine = self.n
        self.ws.send(json.dumps({"id": mine, "method": method, "params": params or {}}))
        deadline = time.monotonic() + timeout
        while True:
            self.ws.settimeout(max(0.1, deadline - time.monotonic()))
            msg = json.loads(self.ws.recv())
            if msg.get("id") == mine:
                if "error" in msg:
                    raise RuntimeError("%s: %s" % (method, msg["error"].get("message")))
                return msg.get("result", {})
            if "method" in msg:
                self.events.append(msg)
                del self.events[:-200]


# Read-only questions for the live page. The one thing it touches is requestAnimationFrame, wrapped
# for three seconds to count how often something asks for a frame, and put back.
PAGE_JS = r"""
(async () => {
  const P = window.Patchwork || {}, r = {};
  r.url = location.href;
  r.viewport = [innerWidth, innerHeight, devicePixelRatio];
  r.cores = navigator.hardwareConcurrency; r.deviceMemoryGB = navigator.deviceMemory;
  try { r.midiPermission = (await navigator.permissions.query({name: "midi", sysex: true})).state; }
  catch (e) { r.midiPermission = String(e); }
  const M = P.midi;
  if (M) {
    r.sysex = M.sysex;
    const list = kind => M.ports(kind).map(p => ({name: p.name, manufacturer: p.manufacturer, state: p.state,
                                                  connection: p.connection, id: p.id}));
    r.inputs = list("inputs"); r.outputs = list("outputs");
  }
  if (P.surface) {
    r.surfaceConnected = P.surface.connected;
    try { r.surfaceAvailable = P.surface.available; } catch (e) { r.surfaceAvailable = String(e); }
    try { r.surfaceTraffic = (P.surface.traffic || []).slice(-8); } catch (e) {}
  }
  if (P.kiosk) r.kioskLog = P.kiosk.log.map(l => new Date(l.t).toISOString().slice(11, 19) + " " + l.what);
  /* what the rack was doing while this was measured: every number below means something different
     with six transports running than with none */
  try { r.playing = P.scenes ? P.scenes.instruments.filter(i => P.scenes.playing(i.id)).map(i => i.id) : null; }
  catch (e) { r.playing = String(e); }
  const view = document.querySelector("#stView .st-sel");
  r.view = view ? view.dataset.v : null;
  const c = P.audio && P.audio.ctx;
  if (c) r.audio = {state: c.state, sampleRate: c.sampleRate, baseLatency: c.baseLatency, outputLatency: c.outputLatency};
  try {
    const gl = document.createElement("canvas").getContext("webgl");
    const x = gl && gl.getExtension("WEBGL_debug_renderer_info");
    r.webglRenderer = gl ? (x ? gl.getParameter(x.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER)) : "no WebGL";
  } catch (e) { r.webglRenderer = String(e); }
  r.domNodes = document.getElementsByTagName("*").length;
  const rafOrig = window.requestAnimationFrame.bind(window);
  let frames = 0;
  window.requestAnimationFrame = cb => { frames++; return rafOrig(cb); };
  const late = [];
  await new Promise(done => {
    const start = performance.now();
    let last = start;
    const tick = () => {
      const now = performance.now();
      late.push(now - last - 10); last = now;
      if (now - start < 3000) setTimeout(tick, 10); else done();
    };
    setTimeout(tick, 10);
  });
  window.requestAnimationFrame = rafOrig;
  late.sort((a, b) => a - b);
  const q = f => Math.round(late[Math.min(late.length - 1, Math.floor(late.length * f))]);
  r.mainThread = {timerLateMs: {p50: q(.5), p95: q(.95), max: q(1)}, animationFrameRequestsPerSec: Math.round(frames / 3)};
  return r;
})()
"""


def gpu(browser):
    g = browser.call("SystemInfo.getInfo").get("gpu", {})
    aux = g.get("auxAttributes") or {}
    keep = ("glRenderer", "glVendor", "glVersion", "displayType", "gpuCompositingDisabled", "sandboxed")
    return {"featureStatus": g.get("featureStatus"), "devices": g.get("devices"),
            "aux": {k: aux[k] for k in keep if k in aux},
            "driverBugWorkarounds": len(g.get("driverBugWorkarounds") or [])}


def web_audio(page, seconds=5):
    """⚠️ THE NUMBER THAT SAYS WHETHER THE SOUND CAN KEEP UP. renderCapacity is the share of each audio
    callback's time the page spent rendering — DevTools' WebAudio panel shows the same — so at 1.0 notes
    break up whatever else is true. The same measurement the laptop made of the rack on 2026-09-13 (about
    0.09 with six instruments playing on an M3 Max), so the two can be set side by side. WebAudio.enable
    reports the contexts that already exist."""
    page.events = []
    page.call("WebAudio.enable")
    page.call("Runtime.evaluate", {"expression": "1"})
    ids = [e["params"]["context"]["contextId"] for e in page.events
           if e.get("method") == "WebAudio.contextCreated"
           and e["params"]["context"].get("contextType") == "realtime"]
    if not ids:
        page.call("WebAudio.disable")
        return {"realtimeContexts": 0}
    caps, intervals = [], []
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        d = page.call("WebAudio.getRealtimeData", {"contextId": ids[-1]}).get("realtimeData", {})
        caps.append(d.get("renderCapacity", 0))
        intervals.append(d.get("callbackIntervalMean", 0))
        time.sleep(0.25)
    page.call("WebAudio.disable")
    caps.sort()
    return {"realtimeContexts": len(ids),
            "renderCapacity": {"mean": round(sum(caps) / len(caps), 3),
                               "p95": round(caps[min(len(caps) - 1, int(len(caps) * .95))], 3),
                               "max": round(caps[-1], 3)},
            "callbackIntervalMs": round(1000 * sum(intervals) / len(intervals), 2)}


def main_thread(page, seconds=5):
    page.call("Performance.enable")
    a = {m["name"]: m["value"] for m in page.call("Performance.getMetrics")["metrics"]}
    time.sleep(seconds)
    b = {m["name"]: m["value"] for m in page.call("Performance.getMetrics")["metrics"]}
    span = (b.get("Timestamp", 0) - a.get("Timestamp", 0)) or seconds
    out = {k + " (seconds per second)": round((b.get(k, 0) - a.get(k, 0)) / span, 3)
           for k in ("TaskDuration", "ScriptDuration", "RecalcStyleDuration", "LayoutDuration")}
    out.update({k + " per second": round((b.get(k, 0) - a.get(k, 0)) / span, 1) for k in ("RecalcStyleCount", "LayoutCount")})
    out["JSHeapUsedMB"] = round(b.get("JSHeapUsedSize", 0) / 1e6, 1)
    out["Nodes"] = b.get("Nodes")
    return out


def main():
    print("jam-diagnose, " + time.strftime("%Y-%m-%d %H:%M:%S"), flush=True)
    section("the board")
    sh("tr -d '\\0' < /proc/device-tree/model; echo; uname -r; echo \"cores: $(nproc)\"; free -m; uptime")
    section("memory: who holds it")
    sh("swapon --show 2>/dev/null; echo '-- memory pressure (time stalled waiting for memory)'; "
       "cat /proc/pressure/memory 2>/dev/null || echo '(not reported)'")
    processes()
    section("heat, power and CPU speed")
    sh("if command -v vcgencmd >/dev/null; then vcgencmd measure_temp; vcgencmd get_throttled; "
       "else echo \"$(( $(cat /sys/class/thermal/thermal_zone0/temp) / 1000 )) C (no vcgencmd)\"; fi; "
       "for p in /sys/devices/system/cpu/cpufreq/policy*; do echo \"$p: $(cat $p/scaling_governor), "
       "$(( $(cat $p/scaling_cur_freq) / 1000 )) of $(( $(cat $p/scaling_max_freq) / 1000 )) MHz\"; done")
    section("busiest processes, over 3 s")
    sh("top -b -d 3 -n 2 -o %CPU -w 200 | awk '/^top -/{n++} n==2' | head -25")
    section("threads with realtime scheduling, or over 5% CPU")
    sh("ps -eLo pid,tid,cls,rtprio,ni,pcpu,comm --sort=-pcpu | awk 'NR==1 || $3!=\"TS\" || $6>5' | head -30")
    section("the services")
    sh("systemctl --no-pager --lines=0 status jam-server jam-kiosk 2>&1 | grep -E '^[^ ].*jam-|Active:|Main PID'")
    sh("journalctl -u jam-kiosk -b --no-pager -n 80 2>&1 | grep -v -E 'ERROR:dbus|object_proxy' | tail -40")
    section("sound cards, MIDI and USB")
    sh("cat /proc/asound/cards; ls -l /dev/snd; lsmod | grep -E '^snd_(seq|usb|rawmidi)'; "
       "echo '-- aconnect -l'; aconnect -l; echo '-- amidi -l'; amidi -l; "
       "echo '-- USB products'; for d in /sys/bus/usb/devices/*/product; do printf '%s: %s\\n' \"$d\" \"$(cat $d)\"; done")
    # ⚠️ A DEVICE THAT NEVER ENUMERATED IS IN NO LIST ABOVE. The second Pi's Launchkey was on a bad cable and
    # simply absent (2026-09-13); the kernel's own words are what tell a dead cable from a device drawing more
    # than the port gives, or one that answered and then failed.
    sh("echo '-- the kernel on USB and sound, newest last'; "
       "dmesg 2>/dev/null | grep -iE 'usb [0-9]|usbcore|snd|midi|over-current|voltage' | tail -40")
    section("PipeWire, as jam")
    sh(as_jam("wpctl status"))
    sh(as_jam("pw-metadata -n settings 0"))
    sh(as_jam("pw-top --batch-mode --iterations 2"), timeout=40)
    section("display and boot settings")
    sh("for c in /sys/class/drm/card*-HDMI-A-*; do echo \"$c: $(cat $c/status), edid $(wc -c < $c/edid) bytes, "
       "modes: $(head -3 $c/modes | tr '\\n' ' ')\"; done; echo '-- cmdline.txt'; cat /boot/firmware/cmdline.txt; "
       "echo '-- jam-session.txt, lines in use'; grep -v -E '^#|^$' /boot/firmware/jam-session.txt 2>/dev/null || echo '(none)'")
    # The mode the compositor really runs, which is not what cmdline.txt asks for (see set_screen() in
    # jam-browser), and what jam-browser said about setting it.
    sh("echo '-- the screen, as cage runs it'; " + as_jam(
        "sh -c 'for s in $XDG_RUNTIME_DIR/wayland-[0-9]; do [ -S \"$s\" ] && WAYLAND_DISPLAY=${s##*/} wlr-randr; done'"))
    sh("echo '-- jam-browser, this boot'; journalctl -u jam-kiosk -b --no-pager 2>/dev/null | grep -F 'jam-browser:' | tail -20")
    section("Chromium and the rack, through DevTools")
    try:
        version = json.load(urllib.request.urlopen("http://127.0.0.1:%d/json/version" % DEVTOOLS, timeout=5))
        print("browser:", version.get("Browser"), flush=True)
        browser = DevTools(version["webSocketDebuggerUrl"])
        print("-- GPU", flush=True)
        print(json.dumps(gpu(browser), indent=1), flush=True)
        pages = [t for t in json.load(urllib.request.urlopen("http://127.0.0.1:%d/json/list" % DEVTOOLS, timeout=5))
                 if t.get("type") == "page"]
        print("pages:", [p.get("url") for p in pages], flush=True)
        page = DevTools(pages[0]["webSocketDebuggerUrl"])
        print("-- the page", flush=True)
        r = page.call("Runtime.evaluate", {"expression": PAGE_JS, "awaitPromise": True, "returnByValue": True})
        print(json.dumps(r.get("result", {}).get("value", r), indent=1), flush=True)
        print("-- its main thread over 5 s", flush=True)
        print(json.dumps(main_thread(page), indent=1), flush=True)
        print("-- its audio thread over 5 s", flush=True)
        print(json.dumps(web_audio(page), indent=1), flush=True)
    except Exception as e:
        print("DevTools did not answer: %r" % (e,), flush=True)


if __name__ == "__main__":
    main()
