[Unit]
Description=Jam Session: the rack, fullscreen, in cage
Documentation=https://github.com/tpm08150/harvest-jam-session/blob/main/pi/README.md
Wants=jam-server.service dbus.socket systemd-logind.service
After=jam-server.service dbus.socket systemd-logind.service systemd-user-sessions.service
Conflicts=getty@tty7.service
After=getty@tty7.service
# However many times it falls over, start it again: a box with nobody at it has no other way back.
StartLimitIntervalSec=0

[Service]
Type=simple
User=jam
# ⚠️ A REAL LOGIN SESSION ON TTY7 (see jam-kiosk.pam). That is what lets cage, as an ordinary user,
# open the display and the GPU — and what starts jam's PipeWire, where the sound comes from.
PAMName=jam-kiosk
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user
Environment=PORT=8123 APP_PAGE=index.html DEVTOOLS_PORT=9222
EnvironmentFile=-/etc/jam-session.conf
EnvironmentFile=-/boot/firmware/jam-session.txt
Environment=XDG_SESSION_TYPE=wayland
# Bring tty7 to the front first, as root: a session on a console nobody is showing is not active,
# and an inactive session is not given the display.
ExecStartPre=-+/usr/bin/chvt 7
# -d no window decorations, -s VT switching allowed, -m last: the rack goes on the newest display.
ExecStart=/usr/bin/cage -d -s -m last -- /opt/jam-session/jam-browser
Restart=always
RestartSec=3
# ⚠️ ROOM FOR A REALTIME AUDIO THREAD. Chromium asks for realtime scheduling for the thread that renders
# Web Audio, and an ordinary user is refused it without an RLIMIT_RTPRIO — on a Pi 4 the difference
# between sound that keeps up and sound that breaks up whenever the page redraws.
LimitRTPRIO=95

[Install]
WantedBy=multi-user.target
