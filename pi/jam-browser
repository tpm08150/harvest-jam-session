#!/usr/bin/env python3
"""Bring the Jam Session rack up in Chromium with nobody in front of it.

    jam-browser                     the kiosk: what cage runs, or the whole of it with SCREEN=off
    jam-browser --session           what jam-kiosk.service runs: cage around this, or with SCREEN=off just this
    jam-browser --wait-for-server   exit 0 once the page server answers, 1 after a minute
    jam-browser --smoke             headless: load the rack, check it came up, exit 0 or 1
    jam-browser --smoke --expect-offline
                                    ...and check this copy's sign-in gate stood down

The kiosk, in order: start Chromium on about:blank with a DevTools port on 127.0.0.1; grant
MIDI, SysEx and audio capture to the rack's origin over the DevTools protocol; wait for the page
server; load the rack; then keep an eye on it. When Chromium exits so does this, and cage with it,
and systemd starts the lot again.

⚠️ WHY THE DEVTOOLS PROTOCOL. MIDI and SysEx are permissions, and no Chromium policy grants them:
checked against all 1,424 policy definitions in Chromium's source on 2026-09-13. The two names the
first pi/setup.sh wrote into a managed policy do not exist, and Chromium ignores a policy it does
not know without a word, so that Pi would have sat on a permission prompt nobody could click. A
permission granted over the protocol before the page asks is the permission the click would have
given.

Settings come from the environment, which the systemd units fill from /etc/jam-session.conf and
jam-session.txt on the boot partition: PORT, APP_PAGE, DEVTOOLS_PORT, SCREEN, EXTRA_CHROMIUM_FLAGS —
and CHROMIUM and JAM_PROFILE to point it somewhere else.
"""
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
import urllib.request

PORT = int(os.environ.get("PORT") or 8123)
PAGE = os.environ.get("APP_PAGE") or "index.html"
ORIGIN = "http://localhost:%d" % PORT
DEVTOOLS = int(os.environ.get("DEVTOOLS_PORT") or 9222)
CHROMIUM = os.environ.get("CHROMIUM") or "/usr/bin/chromium"
PROFILE = os.environ.get("JAM_PROFILE") or os.path.expanduser("~/.local/share/jam-session/chromium")
# The mode the screen runs at: WIDTHxHEIGHT, or "native" for whatever the screen prefers. See set_screen().
SCREEN = (os.environ.get("SCREEN") or "off").strip().lower()
# ⚠️ NO SCREEN IS THE DEFAULT, AND IT IS MOST OF THE MACHINE. SCREEN=off runs Chromium headless — no cage, no
# Wayland, nothing composited — and loads the rack with ?screenless (src/shell/host.js), which draws nothing
# and is played entirely from the controller. Measured on the laptop on 2026-09-19 with six instruments
# playing, drawing was 0.87 of the browser's 1.11 s of CPU a second; what is left is the audio thread. On
# the third Pi the renderer and the GPU process had averaged 81% and 67% of a core between them while the
# main thread that schedules every note waited its turn. ⚠️ NOT YET RUN ON A PI: that headless Chromium
# reaches PipeWire and the ALSA sequencer as the windowed one does is expected, not seen.
SCREENLESS = SCREEN in ("off", "none", "no", "headless")
# ⚠️ THE PAGE REMEMBERS SCREENLESS in the profile's localStorage, as it remembers kiosk, so a card switched
# back to a picture has to say so or the screen comes up blank.
URL = "%s/%s?%s" % (ORIGIN, PAGE, "screenless" if SCREENLESS else "kiosk&screenless=off")

# Permission descriptors, named as the page's own navigator.permissions names them. SysEx is what
# lights the Launchkey's screen; the microphone is VC·1's and LP·1's input and what lets the output
# picker read device names; speaker-selection is the output picker itself; persistent-storage keeps
# the songs saved in the profile from being evicted.
PERMISSIONS = [{"name": "midi"}, {"name": "midi", "sysex": True}, {"name": "microphone"},
               {"name": "speaker-selection"}, {"name": "persistent-storage"}]
# The same as Browser.grantPermissions types, for a Chromium without setPermission.
LEGACY_TYPES = ["midi", "midiSysex", "audioCapture", "speakerSelection", "durableStorage"]

FLAGS = [
    "--user-data-dir=" + PROFILE,
    "--remote-debugging-port=%d" % DEVTOOLS,       # Chromium binds it to 127.0.0.1
    "--no-first-run",
    "--no-default-browser-check",
    "--password-store=basic",                      # no keyring to unlock on a box with no desktop
    "--autoplay-policy=no-user-gesture-required",
    # ⚠️ A PAGE NOBODY IS LOOKING AT IS STILL PLAYING. Chromium throttles the timers of a page it
    # thinks is hidden. The clock is safe on its AudioWorklet either way, but the Launchkey's LEDs
    # and screen repaint on a timer, and would crawl.
    "--disable-background-timer-throttling",
    "--disable-renderer-backgrounding",
    "--disable-backgrounding-occluded-windows",
    "--disable-features=Translate,MediaRouter,IntensiveWakeUpThrottling",
    # Nothing to fetch on a box with no account and usually no network. The second Pi's journal was
    # full of Chromium failing to register with Google's push service, over and over (2026-09-13).
    "--disable-background-networking",
    "--noerrdialogs",
    "--disable-session-crashed-bubble",
    "--disable-infobars",
    "--overscroll-history-navigation=0",
    "--disable-pinch",
    "--check-for-update-interval=31536000",
]


def log(*parts):
    print("jam-browser:", *parts, flush=True)


def http_json(url, timeout=2.0):
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return json.load(r)


def server_up():
    try:
        req = urllib.request.Request("%s/%s" % (ORIGIN, PAGE), method="HEAD")
        with urllib.request.urlopen(req, timeout=2.0) as r:
            return r.status == 200
    except Exception:
        return False


def wait_for_server(seconds=60):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if server_up():
            return True
        time.sleep(0.5)
    return False


class DevTools:
    """One WebSocket to one DevTools target. Events that arrive while waiting for an answer are
    kept, the newest 200 of them, for anyone who wants to read what the page threw."""

    def __init__(self, ws_url):
        import websocket                           # python3-websocket; not needed for --wait-for-server
        self._ws_lib = websocket
        # ⚠️ NO ORIGIN HEADER. Chromium refuses a DevTools connection carrying an Origin it was not
        # told to allow, and the client library sends one unless asked not to.
        self.ws = websocket.create_connection(ws_url, timeout=10, suppress_origin=True)
        self.seq = 0
        self.events = []

    def call(self, method, params=None, timeout=15.0):
        self.seq += 1
        mine = self.seq
        self.ws.send(json.dumps({"id": mine, "method": method, "params": params or {}}))
        deadline = time.monotonic() + timeout
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                raise TimeoutError(method)
            self.ws.settimeout(left)
            try:
                msg = json.loads(self.ws.recv())
            except self._ws_lib.WebSocketTimeoutException:
                raise TimeoutError(method)
            if msg.get("id") == mine:
                if "error" in msg:
                    raise RuntimeError("%s: %s" % (method, msg["error"].get("message")))
                return msg.get("result", {})
            if "method" in msg:
                self.events.append(msg)
                del self.events[:-200]

    def evaluate(self, expression, timeout=15.0):
        r = self.call("Runtime.evaluate", {"expression": expression, "awaitPromise": True,
                                           "returnByValue": True}, timeout)
        if "exceptionDetails" in r:
            raise RuntimeError("page threw: %s" % r["exceptionDetails"].get("text"))
        return r.get("result", {}).get("value")

    def close(self):
        try:
            self.ws.close()
        except Exception:
            pass


def launch(headless):
    os.makedirs(PROFILE, exist_ok=True)
    args = [CHROMIUM] + FLAGS
    args += ["--headless=new"] if headless else ["--kiosk", "--ozone-platform-hint=auto"]
    if os.environ.get("JAM_NO_SANDBOX") == "1":
        # Only for the build's check inside the image: the build machine forbids the namespaces
        # Chromium's sandbox is made of. The Pi itself runs sandboxed.
        args.append("--no-sandbox")
    args += shlex.split(os.environ.get("EXTRA_CHROMIUM_FLAGS") or "")
    args.append("about:blank")
    log("starting", " ".join(shlex.quote(a) for a in args))
    return subprocess.Popen(args)


def stop(proc, grace=5.0):
    if proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(grace)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()


def devtools_version(proc, seconds=60):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            raise RuntimeError("chromium exited (%s) before DevTools came up" % proc.returncode)
        try:
            return http_json("http://127.0.0.1:%d/json/version" % DEVTOOLS)
        except Exception:
            time.sleep(0.25)
    raise TimeoutError("DevTools did not come up in %d s" % seconds)


def page_target():
    for t in http_json("http://127.0.0.1:%d/json/list" % DEVTOOLS):
        if t.get("type") == "page" and t.get("webSocketDebuggerUrl"):
            return t["webSocketDebuggerUrl"]
    raise RuntimeError("Chromium has no page to load the rack into")


def describe(descriptor):
    return descriptor["name"] + ("+sysex" if descriptor.get("sysex") else "")


def wlr_heads():
    """The outputs the compositor has, as wlr-randr lists them — [{name, enabled, modes: [{width, height,
    refresh, current}]}] — or None when it will not say. JSON where this wlr-randr has it, its text
    otherwise."""
    try:
        r = subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True, timeout=10)
        if r.returncode == 0:
            try:
                return [{"name": h["name"], "enabled": bool(h.get("enabled")),
                         "modes": [{"width": int(m["width"]), "height": int(m["height"]),
                                    "refresh": float(m.get("refresh") or 0), "current": bool(m.get("current"))}
                                   for m in h.get("modes") or []]} for h in json.loads(r.stdout)]
            except (ValueError, KeyError, TypeError):
                pass
        r = subprocess.run(["wlr-randr"], capture_output=True, text=True, timeout=10)
        if r.returncode != 0:
            return None
    except (OSError, subprocess.TimeoutExpired):
        return None
    heads, head = [], None
    for line in r.stdout.splitlines():
        if line and not line[0].isspace():
            head = {"name": line.split()[0], "enabled": True, "modes": []}
            heads.append(head)
        elif head is not None:
            m = re.match(r"\s+Enabled:\s*(yes|no)", line)
            if m:
                head["enabled"] = m.group(1) == "yes"
            m = re.match(r"\s+(\d+)x(\d+) px, ([\d.]+) Hz(?: \((.*)\))?", line)
            if m:
                head["modes"].append({"width": int(m.group(1)), "height": int(m.group(2)),
                                      "refresh": float(m.group(3)), "current": "current" in (m.group(4) or "")})
    return heads


def pick_mode(modes, width, height):
    """The size asked for, at the refresh nearest 60 Hz; failing that, the largest mode that fits inside it."""
    pool = [m for m in modes if (m["width"], m["height"]) == (width, height)]
    pool = pool or [m for m in modes if m["width"] <= width and m["height"] <= height]
    if not pool:
        return None
    biggest = max(m["width"] * m["height"] for m in pool)
    return min((m for m in pool if m["width"] * m["height"] == biggest),
               key=lambda m: (abs(m["refresh"] - 60), -m["refresh"]))


def mode_arg(m):
    """⚠️ A WHOLE-HERTZ REFRESH OR NONE. wlr-randr matches a mode by millihertz, and 59.94 read back from its
    own listing does not survive float arithmetic to 59940; a size alone takes the first mode of that size,
    which is the kernel's highest refresh."""
    if not m:
        return "?"
    if abs(m["refresh"] - round(m["refresh"])) < 0.001:
        return "%dx%d@%dHz" % (m["width"], m["height"], round(m["refresh"]))
    return "%dx%d" % (m["width"], m["height"])


def set_screen():
    """⚠️ CAGE RUNS A SCREEN AT ITS PREFERRED MODE, WHATEVER cmdline.txt SAYS. The second Pi (2026-09-13)
    had video=HDMI-A-1:1920x1080@60D on its kernel command line and a 4K television on HDMI, and cage
    ran the television at 3840x2160: the page reported a 3840x2160 viewport, Chromium drew four times
    the pixels of 1080p, the page got about two frames a second, and the board — a 1 GB Pi 4 — was
    313 MB into swap with the rack sitting idle. video= still does its own job, keeping the connector on
    with nothing plugged in; the mode a compositor runs is a separate choice, made here through
    wlr-output-management before Chromium opens its window at whatever size the output then is."""
    if SCREEN in ("", "native", "auto"):
        log("screen: the display's own mode (SCREEN=%s)" % (SCREEN or "unset"))
        return
    size = re.match(r"^(\d+)\s*x\s*(\d+)$", SCREEN)
    if not size:
        log("screen: SCREEN=%r is not WIDTHxHEIGHT or native; the mode is left alone" % SCREEN)
        return
    if not shutil.which("wlr-randr") or not os.environ.get("WAYLAND_DISPLAY"):
        log("screen: no wlr-randr, or no Wayland compositor around this; the mode is left alone")
        return
    width, height = int(size.group(1)), int(size.group(2))
    heads = None
    for _ in range(20):                            # cage may still be bringing its outputs up
        heads = wlr_heads()
        if heads and any(h["enabled"] and h["modes"] for h in heads):
            break
        time.sleep(0.5)
    if not heads:
        log("screen: wlr-randr listed no outputs; the mode is left alone")
        return
    changed = False
    for h in heads:
        if not h["enabled"]:
            continue
        cur = next((m for m in h["modes"] if m["current"]), None)
        want = pick_mode(h["modes"], width, height)
        if not want:
            log("screen: %s has no mode that fits %dx%d; left at %s" % (h["name"], width, height, mode_arg(cur)))
        elif cur and (cur["width"], cur["height"]) == (want["width"], want["height"]):
            log("screen: %s is already %s" % (h["name"], mode_arg(cur)))
        else:
            r = subprocess.run(["wlr-randr", "--output", h["name"], "--mode", mode_arg(want)],
                               capture_output=True, text=True, timeout=15)
            log("screen: %s %s -> %s%s" % (h["name"], mode_arg(cur), mode_arg(want),
                                           "" if r.returncode == 0 else " FAILED: " + (r.stderr or r.stdout).strip()))
            changed = changed or r.returncode == 0
    if changed:
        time.sleep(1)
        for h in wlr_heads() or []:
            if h["enabled"]:
                log("screen: %s now runs %s" % (h["name"], mode_arg(next((m for m in h["modes"] if m["current"]), None))))


def grant(browser):
    """⚠️ setPermission ONE DESCRIPTOR AT A TIME — never grantPermissions one at a time. Measured in
    Chrome 152 headless on 2026-09-13, against a page that only queried permission state:
    grantPermissions REPLACES an origin's grants and rejects everything it does not list, so one call
    per permission left MIDI, SysEx and the microphone all denied. The smoke test caught exactly that —
    SysEx denied behind grants Chromium had accepted. setPermission adds one and leaves the rest, so a
    name a later Chromium drops costs only itself."""
    granted = []
    for d in PERMISSIONS:
        try:
            browser.call("Browser.setPermission", {"permission": d, "setting": "granted", "origin": ORIGIN})
            granted.append(describe(d))
        except Exception as e:
            log("could not grant", describe(d), "-", e)
    if "midi+sysex" not in granted:
        # A Chromium without setPermission: one call naming everything, because it replaces.
        try:
            browser.call("Browser.grantPermissions", {"permissions": LEGACY_TYPES, "origin": ORIGIN})
            granted = ["midi", "midi+sysex", "(all, by grantPermissions)"]
        except Exception as e:
            log("grantPermissions failed as well -", e)
    log("granted", ", ".join(granted) or "nothing", "to", ORIGIN)
    return granted


def bring_up(headless):
    if not headless:
        try:
            set_screen()
        except Exception as e:                     # a mode is a nicety; the rack is the point
            log("screen: could not set the mode -", e)
    proc = launch(headless)
    try:
        version = devtools_version(proc)
        log("chromium", version.get("Browser", "?"))
        browser = DevTools(version["webSocketDebuggerUrl"])
        # ⚠️ BEFORE THE PAGE, not after it: a page that asks first gets a prompt, and a grant that
        # arrives while the prompt is up is not known to answer it.
        granted = grant(browser)
        if not wait_for_server():
            raise RuntimeError("the page server at %s never answered" % ORIGIN)
        page = DevTools(page_target())
        page.call("Runtime.enable")
        page.call("Page.enable")
        page.call("Page.navigate", {"url": URL})
        log("loading", URL)
        return proc, browser, page, granted
    except BaseException:
        stop(proc)
        raise


HEALTHY = "!!(window.Patchwork && Patchwork.kiosk && Patchwork.kiosk.on)"


def session():
    """What jam-kiosk.service starts. A screen needs a compositor, so cage runs this again inside itself;
    no screen needs neither, and this process becomes the kiosk. One unit either way, because the PAM
    session it opens is also what starts jam's PipeWire."""
    if SCREENLESS:
        log("SCREEN=%s: no compositor, Chromium headless, the rack screenless" % SCREEN)
        return kiosk()
    # -d no window decorations, -s VT switching allowed, -m last: the rack goes on the newest display.
    os.execvp("cage", ["cage", "-d", "-s", "-m", "last", "--", os.path.abspath(__file__)])


def kiosk():
    proc, browser, page, _ = bring_up(headless=SCREENLESS)

    def on_term(*_):
        stop(proc)
        sys.exit(0)
    signal.signal(signal.SIGTERM, on_term)

    missing = stalls = 0
    time.sleep(15)                                 # the rack is a big page on a small computer
    while proc.poll() is None:
        try:
            ok = page.evaluate(HEALTHY, timeout=10)
            stalls = 0
            missing = 0 if ok else missing + 1
        except TimeoutError:
            stalls += 1
            log("the page did not answer (%d)" % stalls)
        except Exception as e:
            missing += 1
            log("health check failed:", e)
        # ⚠️ A RELOAD FIRST, THEN A RESTART. A page that loaded without the rack — an error page, a
        # half-served file — is loaded again. A renderer that has stopped answering at all is not
        # coming back, and ending Chromium lets systemd start everything clean.
        if missing >= 3:
            log("no rack on the page; loading it again")
            try:
                page.call("Page.navigate", {"url": URL})
            except Exception as e:
                log("reload failed:", e)
            missing = 0
            time.sleep(15)
        if stalls >= 3:
            log("the page stopped answering; restarting Chromium")
            stop(proc)
            break
        time.sleep(5)
    log("chromium exited", proc.wait())
    return 1


SMOKE = r"""
(async () => {
  const P = window.Patchwork, r = {};
  r.patchwork = typeof P === "object";
  r.kiosk = !!(P && P.kiosk && P.kiosk.on);
  r.screenless = !!(P && P.screenless);
  r.display = getComputedStyle(document.documentElement).display;
  r.cloudConfigured = P && P.cloud ? !!P.cloud.configured : null;
  const gate = document.querySelector("#jamGate");
  r.gateShown = !!(gate && !gate.hidden);
  try { r.midiPermission = (await navigator.permissions.query({name: "midi", sysex: true})).state; }
  catch (e) { r.midiPermission = "error: " + e.message; }
  try {
    r.midiAccess = await Promise.race([
      navigator.requestMIDIAccess({sysex: true}).then(() => "granted"),
      new Promise(done => setTimeout(() => done("still waiting after 8 s"), 8000))]);
  } catch (e) { r.midiAccess = e.name + ": " + e.message; }
  r.audio = P && P.audio && P.audio.ctx ? P.audio.ctx.state : null;
  r.kioskLog = P && P.kiosk ? P.kiosk.log.map(l => l.what) : [];
  return r;
})()
"""


def smoke(expect_offline):
    proc, browser, page, granted = bring_up(headless=True)
    try:
        deadline = time.monotonic() + 120
        loaded = "location.href.startsWith(%s) && document.readyState === 'complete'" % json.dumps(ORIGIN)
        while not page.evaluate(loaded):
            if time.monotonic() > deadline:
                raise TimeoutError("the rack did not finish loading in 120 s")
            time.sleep(0.5)
        time.sleep(8)                              # kiosk.js starts on load and retries every 2 s
        r = page.evaluate(SMOKE, timeout=45) or {}
        problems = []

        def check(ok, what):
            print("  %s  %s" % ("ok  " if ok else "FAIL", what), flush=True)
            if not ok:
                problems.append(what)

        check("midi" in granted and "midi+sysex" in granted, "MIDI and SysEx granted over DevTools")
        check(r.get("patchwork"), "the rack loaded (window.Patchwork)")
        check(r.get("kiosk"), "kiosk mode is on")
        check(bool(r.get("screenless")) == SCREENLESS and (r.get("display") == "none") == SCREENLESS,
              "the page is %s (SCREEN=%s, screenless %s, display %s)"
              % ("screenless" if SCREENLESS else "drawn", SCREEN, r.get("screenless"), r.get("display")))
        check(r.get("midiPermission") == "granted",
              "the page sees MIDI with SysEx as granted (%s)" % r.get("midiPermission"))
        access = str(r.get("midiAccess"))
        # No MIDI hardware in a build machine's chroot, so failing to START is fine. Being
        # refused, or left waiting on a prompt, is the bug this exists to catch.
        check(not access.startswith(("NotAllowedError", "SecurityError", "still waiting")),
              "requestMIDIAccess was neither refused nor left waiting (%s)" % access)
        if expect_offline:
            # False: the switched line in shell/cloud.js. None: a page built without cloud.js at all
            # (groovebox.html, src/box/parts.txt), which has nothing to sign in to.
            check(r.get("cloudConfigured") in (False, None),
                  "cloud sync is off in this copy (%s)" % ("absent" if r.get("cloudConfigured") is None else "switched off"))
            check(not r.get("gateShown"), "the sign-in gate is not in the way")
        print("  info  audio context: %s" % r.get("audio"), flush=True)
        print("  info  kiosk log: %s" % ("; ".join(r.get("kioskLog") or []) or "(empty)"), flush=True)
        thrown = [e["params"].get("exceptionDetails", {}) for e in page.events
                  if e.get("method") == "Runtime.exceptionThrown"]
        for t in thrown[:10]:
            print("  info  the page threw: %s" % ((t.get("exception") or {}).get("description") or t.get("text")),
                  flush=True)
        print("smoke: %s" % ("FAILED: " + "; ".join(problems) if problems else "passed"), flush=True)
        return 1 if problems else 0
    finally:
        page.close()
        browser.close()
        stop(proc)


def main(argv):
    if "--wait-for-server" in argv:
        return 0 if wait_for_server() else 1
    if "--smoke" in argv:
        return smoke("--expect-offline" in argv)
    if "--session" in argv:
        return session()
    return kiosk()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
    except SystemExit:
        raise
    except Exception as e:
        log("failed:", e)
        sys.exit(1)
